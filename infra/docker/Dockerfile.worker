# SEM V2 Worker — Multi-stage build
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/types/package.json packages/types/tsconfig.json packages/types/
COPY packages/crypto/package.json packages/crypto/tsconfig.json packages/crypto/
COPY apps/worker/package.json apps/worker/tsconfig.json apps/worker/
COPY turbo.json ./

RUN pnpm install --frozen-lockfile

COPY packages/types/src packages/types/src/
COPY packages/crypto/src packages/crypto/src/
COPY apps/worker/src apps/worker/src/

RUN pnpm --filter @sem/types build && \
    pnpm --filter @sem/crypto build && \
    pnpm --filter @sem/worker build

FROM node:22-alpine AS runtime

RUN addgroup -g 1001 -S sem && adduser -S -u 1001 -G sem sem

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY --from=builder /app/pnpm-workspace.yaml /app/package.json ./
COPY --from=builder /app/packages/types/package.json packages/types/
COPY --from=builder /app/packages/crypto/package.json packages/crypto/
COPY --from=builder /app/apps/worker/package.json apps/worker/

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder /app/packages/types/dist packages/types/dist/
COPY --from=builder /app/packages/crypto/dist packages/crypto/dist/
COPY --from=builder /app/apps/worker/dist apps/worker/dist/

USER sem

CMD ["node", "apps/worker/dist/main.js"]
