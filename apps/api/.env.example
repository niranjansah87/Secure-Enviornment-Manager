# SEM V2 API — Environment Configuration Example
# Copy to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# The sem_app role must be created out-of-band before running migrations.
# Example: CREATE ROLE sem_app WITH LOGIN PASSWORD '<from secret manager>';
DATABASE_URL=postgresql://sem_app:<password>@localhost:5432/sem_v2

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=<password>

# ── JWT (ES256 ECDSA P-256) ───────────────────────────────────────────────────
# Generate with: pnpm --filter @sem/api keys:generate
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
# Or inline (base64 if needed):
JWT_PRIVATE_KEY=<PEM string with \n as literal newlines>
JWT_PUBLIC_KEY=<PEM string with \n as literal newlines>
JWT_ISSUER=sem-api
JWT_AUDIENCE=sem-web
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Encryption ────────────────────────────────────────────────────────────────
# 32 random bytes, base64-encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEM_MASTER_KEY=<32-byte base64-encoded key>

# HMAC key for O(1) refresh token lookup. Separate from master key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEM_TOKEN_HMAC_KEY=<32-byte base64-encoded key>

# ── Master Token (optional admin bypass) ─────────────────────────────────────
# SEM_MASTER_TOKEN=<long random string>

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── Email (optional) ──────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=<password>
# SMTP_FROM=noreply@sem.local

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW=900

# ── Optional ──────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
# SEM_ADMIN_USERNAME=admin
# SEM_ADMIN_EMAIL=admin@example.com
