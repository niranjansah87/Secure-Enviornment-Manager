# =============================================================================
# Secure Environment Manager V2 — Environment Variables
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env.
# Generate keys:  node apps/api/src/scripts/generate-keys.js
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sem:changeme@localhost:5432/sem

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme@localhost:6379

# ── Passwords (docker-compose only) ──────────────────────────────────────────
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme

# ── JWT (ES256 — ECDSA P-256) ─────────────────────────────────────────────────
# Generate: node -e "const {generateEs256KeyPair}=require('./packages/crypto/dist');const k=generateEs256KeyPair();console.log('PRIVATE:',k.privateKey);console.log('PUBLIC:',k.publicKey)"
JWT_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── Master encryption key (AES-256-GCM key wrapping) ─────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be a base64-encoded 32-byte value.
SEM_MASTER_KEY=

# ── Refresh-token HMAC key ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be base64-encoded, at least 32 bytes.
SEM_TOKEN_HMAC_KEY=

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Set to "true" to expose Swagger UI in production (off by default)
SWAGGER_ENABLED=false

# ── SMTP (optional — for user welcome and password-reset emails) ──────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sem.example.com

# ── DEK rotation threshold (days before a DEK is flagged for rotation) ────────
SEM_DEK_ROTATION_DAYS=90

# ── API port exposed by docker-compose ───────────────────────────────────────
API_PORT=3001
