{
  "name": "sem",
  "private": true,
  "version": "2.0.0",
  "description": "Secure Environment Manager v2 — monorepo root",
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@sem/api",
    "build:frontend": "turbo run build --filter=frontend",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@sem/api",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:worker": "turbo run dev --filter=@sem/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "turbo run db:migrate --filter=@sem/api",
    "db:bootstrap": "pnpm --filter @sem/api run db:bootstrap",
    "db:generate": "turbo run db:generate --filter=@sem/api",
    "keys:generate": "pnpm --filter @sem/api run keys:generate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.11.8",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
