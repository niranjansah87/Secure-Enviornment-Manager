env.domain.ai {
	encode gzip zstd
	log {
		output file /var/log/caddy/dotenv-server.log {
			roll_size 50MB
			roll_keep 5
		}
		format console
	}

	reverse_proxy 127.0.0.1:3001 {
		transport http {
			read_timeout 30s
			write_timeout 30s
		}
	}

	handle_errors {
		rewrite * /server-error.html
		file_server {
			root /var/www/html
		}
	}
}

